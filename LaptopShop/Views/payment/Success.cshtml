@{
    ViewData["Title"] = "Payment Successful";
}

<style>
    :root {
        --success-color: #00b894;
        --success-dark: #00a884;
        --light-color: #f8f9fa;
        --dark-color: #2d3436;
        --secondary-color: #95a5a6;
    }



    .starter-section {
        width: 100%;
        padding: 20px;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 600px;
        margin: 0 auto;
    }

    .card-body {
        padding: 40px;
        text-align: center;
        background: white;
    }

    .section-title h3 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 15px;
        color: var(--success-color);
    }

    .section-title p {
        font-size: 1.1rem;
        color: var(--dark-color);
        margin-bottom: 30px;
    }

    .success-icon {
        font-size: 5rem;
        color: var(--success-color);
        margin-bottom: 25px;
        animation: bounce 1s ease;
    }

    .order-details {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 30px 0;
        text-align: left;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .detail-label {
        color: var(--secondary-color);
        font-weight: 500;
    }

    .detail-value {
        color: var(--dark-color);
        font-weight: 600;
    }

    .action-buttons {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn-primary {
        background-color: var(--success-color);
        border-color: var(--success-color);
        padding: 12px 25px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: var(--success-dark);
            border-color: var(--success-dark);
            transform: translateY(-2px);
        }

    .btn-outline {
        background-color: transparent;
        border: 1px solid var(--success-color);
        color: var(--success-color);
        padding: 12px 25px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background-color: rgba(0, 184, 148, 0.1);
            transform: translateY(-2px);
        }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-20px);
        }

        60% {
            transform: translateY(-10px);
        }
    }

    @@media (max-width: 768px) {
        .card-body {
            padding: 30px 20px;
        }

        .section-title h3 {
            font-size: 1.8rem;
        }

        .action-buttons {
            flex-direction: column;
            gap: 10px;
        }

        .btn-primary, .btn-outline {
            width: 100%;
        }
    }
</style>

<!-- Starter Section Section -->
<section id="starter-section" class="starter-section section">
    <div class="card">
        <div class="card-body">
            <div class="section-title" data-aos="fade-up">
                <div class="success-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3>Payment Successful</h3>
                <p>Thank you for your purchase! Your order has been confirmed.</p>
            </div>

            <div class="order-details" data-aos="fade-up">
                <div class="detail-row">
                    <span class="detail-label">Order Number:</span>
                    <span class="detail-value">#@(Guid.NewGuid().ToString().Substring(0, 8).ToUpper())</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Date:</span>
                    <span class="detail-value">@DateTime.Now.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Method:</span>
                    <span class="detail-value">Credit Card</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value" style="color: var(--success-color);">Completed</span>
                </div>
            </div>

            <div class="action-buttons">
                <a href="/Order/History" class="btn btn-primary">
                    <i class="bi bi-receipt"></i> View Order Details
                </a>
                <a href="/Laptop/Index" class="btn btn-outline">
                    <i class="bi bi-arrow-left"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">