@using Microsoft.Extensions.Options
@model List<LaptopShop.Models.database.Laptop>
@{
    ViewData["Title"] = "Your Shopping Cart";
}

<style>
    :root {
        --primary-color: #6c5ce7;
        --primary-dark: #5649c0;
        --success-color: #00b894;
        --danger-color: #e74c3c;
        --light-color: #f8f9fa;
        --dark-color: #2d3436;
        --secondary-color: #95a5a6;
    }

    body {
        background-color: #f5f6fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-bottom: 50px;
    }

    h1 {
        color: var(--dark-color);
        text-align: center;
        margin: 30px 0;
        font-weight: 600;
    }

    .all_card {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 25px;
        padding: 0 20px;
        margin-bottom: 40px;
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .card-img-top {
        height: 200px;
        object-fit: contain;
        padding: 15px;
        background-color: #f8f9fa;
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 15px;
    }

    .card-text {
        color: var(--secondary-color);
        margin-bottom: 10px;
    }

    .price {
        font-weight: 700;
        color: var(--primary-color);
        font-size: 1.2rem;
    }

    .btn {
        padding: 8px 15px;
        border-radius: 5px;
        font-weight: 500;
        transition: all 0.3s ease;
        margin-right: 10px;
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-primary:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-2px);
        }

    .btn-danger {
        background-color: var(--danger-color);
        border-color: var(--danger-color);
    }

        .btn-danger:hover {
            background-color: #c0392b;
            border-color: #c0392b;
            transform: translateY(-2px);
        }

    .total {
        text-align: center;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--dark-color);
        margin: 30px 0;
    }

        .total span {
            color: var(--primary-color);
        }

    .checkout-section {
        text-align: center;
        margin-top: 30px;
    }

    .btn-success {
        background-color: var(--success-color);
        border-color: var(--success-color);
        padding: 12px 30px;
        font-size: 1.1rem;
        margin-bottom: 20px;
    }

        .btn-success:hover {
            background-color: #00a884;
            border-color: #00a884;
            transform: translateY(-2px);
        }

    .stripe-button {
        margin-top: 20px;
    }

    @@media (max-width: 768px) {
        .all_card {
            grid-template-columns: 1fr;
            padding: 0 15px;
        }

        .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>

<h1>Your Shopping Cart</h1>

@if (Model.Count == 0)
{
    <div class="empty-cart text-center">
        <i class="bi bi-cart-x" style="font-size: 3rem; color: var(--secondary-color);"></i>
        <h3>Your cart is empty</h3>
        <a href="/Laptop/Index" class="btn btn-primary">Continue Shopping</a>
    </div>
}
else
{
    <div class="all_card">
        @foreach (var item in Model)
        {
            <div class="card">
                <img src="/imges/@item.Image" class="card-img-top" alt="@item.name">
                <div class="card-body">
                    <h5 class="card-title">@item.name</h5>
                    <p class="card-text">@item.description</p>
                    <p class="card-text price">@item.price$</p>
                    <div class="d-flex justify-content-between">
                        <a href="/Laptop/gitbyid/@item.Id" class="btn btn-primary">
                            <i class="bi bi-info-circle"></i> Details
                        </a>
                        <a href="/Cart/deletitem?Laptopid=@item.Id&username=@User.Identity.Name" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Remove
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="total">
        <p>Total: <span>@ViewBag.Total $</span></p>
    </div>

    <div class="checkout-section">
      

        <div class="text-center">
            <form asp-action="Charge" asp-controller="payment" method="POST">
                <input type="hidden" name="totalPrice" value="@ViewBag.Total" />
                <script src="https://checkout.stripe.com/v2/checkout.js"
                        class="stripe-button"
                        data-key="pk_test_51QssVg4CGIN3hKytiykaP5GQQUFchVzSPEQhht6hU9R4HIYgO54etixvSCAJeJe4YmaMbe9O1QIKmrWvfHwt9Eta002kHLvwQy"
                        data-locale="auto"
                        data-description="Laptop Purchase"
                        data-amount="@((int)(ViewBag.Total * 100))"
                        data-currency="usd">
                </script>
            </form>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">