@{
    ViewData["Title"] = "Operation Completed";
}

<style>
    :root {
        --success-color: #00b894;
        --dark-color: #2d3436;
        --light-color: #f8f9fa;
    }


    .confirmation-container {
        background: white;
        padding: 50px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 90%;
    }

    .confirmation-icon {
        font-size: 4rem;
        color: var(--success-color);
        margin-bottom: 20px;
        animation: bounce 1s ease;
    }

    .confirmation-message {
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 20px;
    }

    .confirmation-text {
        font-size: 1.1rem;
        color: #636e72;
        margin-bottom: 30px;
        line-height: 1.6;
    }

    .btn-continue {
        background-color: var(--success-color);
        color: white;
        padding: 12px 30px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

        .btn-continue:hover {
            background-color: #00a884;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 184, 148, 0.3);
        }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-20px);
        }

        60% {
            transform: translateY(-10px);
        }
    }
</style>

<div class="confirmation-container">
    <div class="confirmation-icon">
        <i class="bi bi-check-circle-fill"></i>
    </div>
    <h1 class="confirmation-message">Done!</h1>
    <p class="confirmation-text">The Laptop has completed successfully.</p>
    <button onclick="window.location.href='/'" class="btn-continue">
        Continue
    </button>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">